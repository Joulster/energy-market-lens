{
  "info": {
    "title": "Aether - Merit Order List Bid Prices",
    "version": "1.5.0",
    "description": "The Merit Order List for each PTU shows prices and volumes of the bids for regulating and reserve capacity (aFRR and mFRRsa) which TenneT has received from the providers of regulating and reserve capacity. **note: This API is subject to rate limiting**\n\nThe following rate limits apply:\n\n**Production**\n- Maximum requests per second: 1\n- Maximum requests per minute: 10\n- Maximum requests per day: 600\n\n**Acceptance**\n- Maximum requests per second: 1\n- Maximum requests per minute: 60\n- Maximum requests per day: 600\n\nExceeding these limits may result in temporary blocking of your API keys. Please ensure your usage adheres to these limits to maintain uninterrupted access."
  },
  "paths": {
    "/publications/v1/merit-order-list": {
      "get": {
        "tags": [
          "Merit Order List"
        ],
        "summary": "Get Merit Order List Bid Prices data by timeframe",
        "security": [
          {
            "apikey": [
              "read:data"
            ]
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "schema": {
                  "$ref": "#/components/schemas/response_csv"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              },
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/response_json"
                    },
                    {
                      "$ref": "#/components/schemas/no-data"
                    }
                  ]
                }
              }
            },
            "description": "Successful operation."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error-apikey"
                }
              }
            },
            "description": "No valid API key found in request"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error-method"
                }
              }
            },
            "description": "This Method is not allowed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error-missing-information"
                }
              }
            },
            "description": "Missing information, e.g. date range or type."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error-rate-limit"
                }
              }
            },
            "description": "Rate Limit Reached"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error-gateway-timeout"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "date_from",
            "schema": {
              "type": "string",
              "example": "13-01-2025 00:00:00"
            },
            "required": true,
            "description": "The start date and time of the requested time frame."
          },
          {
            "in": "query",
            "name": "date_to",
            "schema": {
              "type": "string",
              "example": "13-01-2025 01:00:00"
            },
            "required": true,
            "description": "The end date and time of the requested time frame, maximum range is 1 hour."
          },
          {
            "in": "header",
            "name": "Accept",
            "schema": {
              "type": "string",
              "example": "application/json"
            },
            "required": true,
            "description": "The response type is the format of the returned answer. Allowed values are: application/json, application/xml, text/csv, application/xlsx"
          }
        ],
        "description": "Use this method to retrieve the data on merit order list bid prices used in a certain timeframe.",
        "operationId": "request_merit_order_list"
      }
    }
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "https://{environment}.tennet.eu",
      "variables": {
        "environment": {
          "enum": [
            "api",
            "api.acc"
          ],
          "default": "api"
        }
      }
    }
  ],
